# Copy to .env.local for local `vercel dev`, or set in Vercel project settings.
# Never commit real values — .env and .env.local are gitignored.

# Required: Resend API key (create at resend.com, then Project Settings > API Keys)
RESEND_API_KEY=

# Optional: inbox that receives Contact form submissions.
# Defaults to contactus@gastonchristianctr.org if unset.
CONTACT_TO_EMAIL=
